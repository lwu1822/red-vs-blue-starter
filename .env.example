# Copy this file to ".env" and fill in your own values.
# The agent reads these three variables at startup (see agent/llm.py).
#
# These defaults use Google Gemini's FREE API tier through its
# OpenAI-compatible endpoint, so the openai library works unchanged.

# Your Gemini API key. KEEP THIS SECRET — never commit it.
# Get a free key at https://aistudio.google.com/apikey (no credit card needed).
LLM_API_KEY=paste-your-gemini-key-here

# Gemini's OpenAI-compatible endpoint. Keep the trailing slash.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Which model to ask. gemini-3.5-flash-lite is a free Gemini model.
# (If it's ever unavailable, gemini-3.8-flash is a good backup -- see README.)
LLM_MODEL=gemini-3.5-flash-lite
